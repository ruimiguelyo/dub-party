{
  "name": "Dub Party",
  "short_name": "Dub Party",
  "description": "Dobra cenas com os teus amigos: escolhe uma personagem, grava as falas e vejam a dobragem juntos. Grátis, no browser.",
  "lang": "pt",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b1011",
  "theme_color": "#0b1011",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/zip": [".zip"], "application/x-7z-compressed": [".7z"], "application/vnd.rar": [".rar"] } }
  ]
}
